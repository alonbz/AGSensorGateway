<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/textVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:text="גרסה: 1.0.25"
        android:textColor="#888888"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="לא סורק"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/buttonToggleScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="התחל סריקה (תצוגה פסיבית)" />

    <Button
        android:id="@+id/buttonToggleDebug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="הצג פרטים טכניים (GATT / יומן)" />

    <!-- Hidden by default so the sensor list below gets the screen's
         full height for everyday use. Toggled open on demand for GATT
         connect / raw log debugging — its own fixed-height ScrollView
         keeps it from pushing the filter box and list off-screen. -->
    <ScrollView
        android:id="@+id/debugSection"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:background="#0D0D0D">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:text="חיבור ישיר לפי MAC (עוקף את הצורך לזהות את החיישן ברשימה)"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <EditText
                android:id="@+id/editMac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:hint="MAC, לדוגמה BC:57:29:26:BD:EF (אפשר גם בלי נקודותיים)" />

            <EditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:text="0000000000000000"
                android:hint="סיסמת החיישן" />

            <Button
                android:id="@+id/buttonGattConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="התחבר ישירות (GATT)" />

            <Button
                android:id="@+id/buttonExploreGatt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="חיבור גנרי לחקירת K7800P (משתמש ב-MAC למעלה)" />

            <TextView
                android:id="@+id/textGattStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:paddingTop="8dp"
                android:text="לא מחובר" />

            <TextView
                android:id="@+id/textGattReading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:paddingTop="4dp"
                android:text="—" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:paddingTop="12dp"
                android:text="יומן טכני:"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:textColor="#66FF99"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:text="" />

        </LinearLayout>
    </ScrollView>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#333333" android:layout_marginVertical="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="הצג רק חיישן מסוים (הקלד MAC/שם, או הקש על שורה ברשימה למטה)"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editFilterMac"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="MAC או שם, בלי צורך בנקודותיים (ריק = הכל)"
            android:inputType="textCapCharacters" />

        <Button
            android:id="@+id/buttonClearFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="נקה" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSensors"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp" />

</LinearLayout>
