<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="לא סורק"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Search/focus row, kept near the TOP so it's usable as soon as
         several sensors show up in the list below — no need to scroll
         past anything to reach it. Typing filters the list by MAC or
         name; tapping a row in the list below (see MainActivity's
         onItemClick) fills this box with that row's MAC, "focusing" on
         just that one sensor. "נקה" clears back to showing everyone. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/editFilterMac"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="חיפוש חיישן (MAC או שם)"
            android:inputType="textCapCharacters" />

        <Button
            android:id="@+id/buttonClearFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="נקה" />
    </LinearLayout>

    <!-- Scans a barcode/QR off the physical sensor's label to get its MAC,
         then starts a scan filtered (at the BLE hardware level, via
         ScanFilter) to just that one address — instead of the usual
         unfiltered scan that reports every BLE device nearby. See
         MainActivity.handleScannedMac() / BarcodeScanActivity. -->
    <Button
        android:id="@+id/buttonScanBarcode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="📷 סרוק בר-קוד של חיישן" />

    <!-- Hidden by default so the sensor list below gets the screen's
         full height for everyday use. Toggled open on demand from the
         "הצג פרטים טכניים" item in the options menu (see MainActivity)
         — its own fixed-height ScrollView keeps it from pushing the
         list off-screen when open. -->
    <ScrollView
        android:id="@+id/debugSection"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:visibility="gone"
        android:layout_marginBottom="8dp"
        android:background="#0D0D0D">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:text="חיבור ישיר לפי MAC (עוקף את הצורך לזהות את החיישן ברשימה)"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <EditText
                android:id="@+id/editMac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:hint="MAC, לדוגמה BC:57:29:26:BD:EF (אפשר גם בלי נקודותיים)" />

            <EditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:text="0000000000000000"
                android:hint="סיסמת החיישן" />

            <Button
                android:id="@+id/buttonGattConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="התחבר ישירות (GATT)" />

            <Button
                android:id="@+id/buttonExploreGatt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="חיבור גנרי לחקירת K7800P (משתמש ב-MAC למעלה)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:paddingTop="10dp"
                android:text="ניסוי כתיבה (רק בזמן שמחוברים דרך הכפתור למעלה):"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFD54F"
                android:textStyle="bold"
                android:text="↓ שדה 1: סוף UUID בלבד (למשל 36f5) ↓" />

            <EditText
                android:id="@+id/editWriteTargetUuid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:text="36f5"
                android:hint="רק סוף ה-UUID, לדוגמה 36f5" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFD54F"
                android:textStyle="bold"
                android:paddingTop="6dp"
                android:text="↓ שדה 2: בייטים בהקסה בלבד (למשל 01) ↓" />

            <EditText
                android:id="@+id/editWriteHexBytes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:hint="רק בייטים בהקסה, לדוגמה 01" />

            <Button
                android:id="@+id/buttonWriteGatt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="שלח (כתוב ל-characteristic)" />

            <TextView
                android:id="@+id/textGattStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:paddingTop="8dp"
                android:text="לא מחובר" />

            <TextView
                android:id="@+id/textGattReading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:paddingTop="4dp"
                android:text="—" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:paddingTop="12dp"
                android:text="יומן טכני:"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:textColor="#66FF99"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:text="" />

        </LinearLayout>
    </ScrollView>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#333333" android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSensors"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
