<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/textVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="גרסה: 1.0.16"
        android:textColor="#888888"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:text="לא סורק"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/buttonToggleScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="התחל סריקה (תצוגה פסיבית)" />

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#333333" android:layout_marginVertical="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="חיבור ישיר לפי MAC (עוקף את הצורך לזהות את החיישן ברשימה)"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/editMac"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="MAC, לדוגמה BC:57:29:26:BD:EF"
        android:inputType="textCapCharacters" />

    <EditText
        android:id="@+id/editPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0000000000000000"
        android:hint="סיסמת החיישן" />

    <Button
        android:id="@+id/buttonGattConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="התחבר ישירות (GATT)" />

    <TextView
        android:id="@+id/textGattStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="לא מחובר" />

    <TextView
        android:id="@+id/textGattReading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:paddingTop="4dp"
        android:text="—" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:text="יומן טכני:"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#111111">
        <TextView
            android:id="@+id/textLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="#66FF99"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:text="" />
    </ScrollView>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#333333" android:layout_marginVertical="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="הצג רק חיישן מסוים (הקלד MAC/שם, או הקש על שורה ברשימה למטה)"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editFilterMac"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="MAC או שם, לדוגמה BC:57:29:26:BD:EF (ריק = הכל)"
            android:inputType="textCapCharacters" />

        <Button
            android:id="@+id/buttonClearFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="נקה" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSensors"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp" />

</LinearLayout>
