    items actually get their live text ("סריקה" vs "עצור סריקה", etc.).
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/action_scan"
        android:title="סריקה"
        android:showAsAction="never" />
    <item
        android:id="@+id/action_debug"
        android:title="הצג פרטים טכניים"
        android:showAsAction="never" />
    <item
        android:id="@+id/action_version"
        android:title="גרסה"
        android:showAsAction="never" />
</menu>
